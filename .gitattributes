# Normalize line endings to LF in the repository, checked out natively.
# Prevents CRLF/LF churn showing up as noise in diffs and git blame.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.pdf binary
