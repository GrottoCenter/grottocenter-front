# Set to true to prevent the map guided tour from launching
# VITE_DISABLE_MAP_TOUR=true

# Local development API
# VITE_API_URL=http://127.0.0.1:1337

# Production API
VITE_API_URL=https://api.grottocenter.org
VITE_OAI_URL=https://oai.grottocenter.org
VITE_Z3950_URL=https://z3950.grottocenter.org
VITE_BI_URL=https://bi.grottocenter.org

# Cloudflare Turnstile site key (anti-bot on the sign-up form).
# Leave empty to disable the widget locally. Use 1x00000000000000000000AA
# for the Cloudflare "always-pass" test key.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAD8NKp9uz2FzLFWV
